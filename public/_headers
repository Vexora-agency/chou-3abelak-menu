/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://tile.openstreetmap.org; media-src 'self' data: blob:; connect-src 'self' https://nominatim.openstreetmap.org; frame-ancestors 'none'; base-uri 'none'; form-action 'self'

/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Entry HTML revalidates every load (never stale: it references hashed /assets/*
# files, so a fresh entry guarantees phones pick up every deploy immediately —
# stale HTML was once the reason a fix "didn't appear" on a device). no-cache
# (not no-store) keeps bfcache eligible: back/forward restores stay instant
# and the app's own 60 s menu refresh + pageshow refresh keep data current.
/
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/style.css
  Cache-Control: public, max-age=3600, must-revalidate

/app.js
  Cache-Control: public, max-age=3600, must-revalidate
