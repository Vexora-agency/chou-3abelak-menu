/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com/beacon.min.js; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://tile.openstreetmap.org https://lh3.googleusercontent.com; media-src 'self' data: blob:; connect-src 'self' https://nominatim.openstreetmap.org https://translate.googleapis.com https://api.mymemory.translated.net https://cloudflareinsights.com https://*.ingest.sentry.io https://*.ingest.de.sentry.io; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'

/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Bare paths fall through to the shell via the unknown-path fallback (see
# _redirects), so they need the same protections as their wildcard siblings.
/admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Invite landing: the token lives in the URL, so it must never be stored,
# indexed, or leaked — no-referrer keeps it out of every Referer header.
# (The page itself loads zero third-party resources regardless.)
/invite/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/invite
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

# Entry HTML revalidates every load (never stale: it references hashed /assets/*
# files, so a fresh entry guarantees phones pick up every deploy immediately —
# stale HTML was once the reason a fix "didn't appear" on a device). no-cache
# (not no-store) keeps bfcache eligible: back/forward restores stay instant
# and the app's own 60 s menu refresh + pageshow refresh keep data current.
/
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/style.css
  Cache-Control: public, max-age=3600, must-revalidate

/app.js
  Cache-Control: public, max-age=3600, must-revalidate
