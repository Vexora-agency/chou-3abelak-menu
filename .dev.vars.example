# Local-only secrets — FAKE VALUES ONLY. Copy to `.dev.vars` (git-ignored, never commit).
# Production values live in the Cloudflare dashboard per client account, never here.
ALLOW_LOCAL_DEV=1

# --- Admin login (generate locally; nothing here is a real credential) ---
# 1) node scripts/hash-password.mjs "YourStrongPasswordHere" -> paste below
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2$260000$<saltB64-from-script>$<hashB64-from-script>
# 2) node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=<base64-of-32-plus-random-bytes>

# --- Reports / backup / audit / scheduler (local test values) ---
# Secrets below are placeholders, NEVER real values. Generate fakes with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SITE_PLAN=pro
RESEND_API_KEY=re_testkey
MAIL_FROM_DOMAIN_EMAIL=reports@example.test
REPLY_TO=owner@example.test
SITE_URL=http://localhost:3000
CRON_SECRET=<64-hex-chars>
PII_RETENTION_DAYS=90
ORDER_RETENTION_MONTHS=13
REPORT_RETENTION_MONTHS=36
BACKUP_SECRET=<64-hex-chars>
AUDIT_SECRET=<64-hex-chars>

# --- Sentry error monitoring (local test values; empty = SDK no-ops) ---
# Backend DSN for `wrangler pages dev` / local runs. NEVER a real secret here.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# Frontend DSN for local Vite builds (public by design; still fake here).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=

# --- Telegram owner notifications (local test values) ---
TELEGRAM_BOT_TOKEN=<bot-token-from-BotFather-or-any-fake-string>
TELEGRAM_BOT_USERNAME=TestRestaurantBot
TELEGRAM_WEBHOOK_SECRET=<64-hex-chars>

# --- Customer auth (Better Auth, local only — FAKE VALUES) ---
# Generate a fresh secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse SESSION_SECRET. Production values live in Cloudflare secrets.
ALLOW_LOCAL_DEV=1
BETTER_AUTH_SECRET=<base64-of-32-plus-random-bytes>
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Phase 4 only (leave blank until Google OAuth is configured):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
