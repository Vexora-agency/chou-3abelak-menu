# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Boosthis web kit (frontend; never commit a real key) ---
# Published-app ("ship") key from the Boosthis dashboard — NOT the normal fix key.
# Baked into the site at build time by Vite. Set the same variable in the
# Cloudflare Pages dashboard for published builds, and in a local untracked
# .env file for development. Without it the site measures on-device only.
VITE_BOOSTHIS_PROJECT_KEY="bk_ship_..."

# --- Admin login (Cloudflare Pages env vars; never commit real values) ---
# Public username shown on the login screen check (exact match, case-sensitive).
ADMIN_USERNAME="admin"
# PBKDF2-SHA256 hash generated with: node scripts/hash-password.mjs "YourStrongPasswordHere"
ADMIN_PASSWORD_HASH="pbkdf2$260000$<saltB64>$<hashB64>"
# Base64 of at least 32 random bytes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="<base64-of-32-plus-random-bytes>"

# --- Monthly reports (Cloudflare Pages env vars; never commit real values) ---
# Site plan: starter (menu display, gated features hidden with 404s) | pro.
SITE_PLAN="pro"
# Resend sending (free plan is enough). Replies go to REPLY_TO (Zoho), never here.
RESEND_API_KEY="re_<key>"
MAIL_FROM_DOMAIN_EMAIL="reports@your-domain.com"
REPLY_TO="owner@your-domain.com"
# Public site URL (logo + dashboard + confirmation links in emails).
SITE_URL="https://your-domain.com"
# Bearer secret for POST /api/internal/run-reports. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="<64-hex-chars>"
# Retention windows (defaults shown; override only if you must).
PII_RETENTION_DAYS="90"
ORDER_RETENTION_MONTHS="13"
REPORT_RETENTION_MONTHS="36"

# --- Backup & history (Cloudflare Pages env vars; never commit real values) ---
# HMAC secret for signed backup envelopes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_SECRET="<64-hex-chars>"

# --- Customer data tool audit (Cloudflare Pages env vars; never commit real values) ---
# HMAC secret for audit entries (phone is hashed, never stored).
AUDIT_SECRET="<64-hex-chars>"

# --- Telegram owner notifications (Cloudflare Pages secrets; never commit real values) ---
# Bot token from @BotFather. Set via dashboard (Pages -> Settings -> Environment
# variables, secret) or: wrangler pages secret put TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN="<bot-token-from-BotFather>"
# Public bot username (the one ending in Bot). Plain Pages variable (NOT a
# secret): set it once and owners link with one tap, no typing, no jargon.
TELEGRAM_BOT_USERNAME="<YourRestaurantBot>"
# Random webhook password (Telegram sends it back as X-Telegram-Bot-Api-Secret-Token).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET="<64-hex-chars>"
